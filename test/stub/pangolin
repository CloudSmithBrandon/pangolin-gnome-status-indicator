#!/usr/bin/env bash
# Deterministic pangolin CLI stub for integration tests.
#
# The scenario file (STUB_SCENARIO, required) holds one word read by
# `status --json` and `pgrep`:
#   negotiating   -> daemon reports connected:false AND a live client
#                    process exists (warm: up must not be re-spawned)
#   connected     -> daemon reports connected AND a live client process
#   disconnected  -> daemon reports disconnected AND no client process
#                    (cold: auto-connect must spawn `up`)
#
# Every invocation is appended to STUB_LOG (required) as "<epoch> <argv...>"
# so tests can assert on call counts and ordering. Both paths are harness-
# provided: refusing to run without them keeps the stub out of /tmp and out
# of any manual invocation that would shadow the real CLI.
set -u
LOG="${STUB_LOG:?STUB_LOG must be set by test/integration-test.sh}"
SCENARIO="${STUB_SCENARIO:?STUB_SCENARIO must be set by test/integration-test.sh}"

printf '%s %s\n' "$(date +%s.%N)" "$*" >> "$LOG"

scenario() { [ -f "$SCENARIO" ] && cat "$SCENARIO" || echo "disconnected"; }

case "$1" in
    up)
        exit 0
        ;;
    down)
        exit 0
        ;;
    status)
        if [ "${2:-}" = "--json" ]; then
            case "$(scenario)" in
                connected)
                    echo '{"connected":true,"version":"9.9.9","orgId":"stub","peers":{"2":{"siteId":2,"name":"stubsite","connected":true,"rtt":5,"isRelay":true}},"networkSettings":{"ipv4_addresses":["100.64.0.1"]}}'
                    ;;
                banner-connected)
                    echo "A new version is available: 9.9.10 (current: 9.9.9)"
                    echo "Run 'pangolin update' to update to the latest version"
                    echo '{"connected":true,"version":"9.9.9"}'
                    ;;
                *)
                    echo '{"connected":false}'
                    ;;
            esac
        else
            case "$(scenario)" in
                connected|negotiating) echo "Client is running" ;;
                *) echo "No client is currently running" ;;
            esac
        fi
        ;;
    version)
        echo "9.9.9"
        ;;
    auth)
        if [ "${2:-}" = "status" ]; then
            echo "Status: logged in"
            echo "@ https://stub.invalid"
        fi
        ;;
    logs)
        [ "${2:-}" = "client" ] || { echo "usage: logs client"; exit 1; }
        echo "stub log line"
        sleep 300
        ;;
    pgrep)
        case "$(scenario)" in
            negotiating|connected) echo "1234 pangolin up client" ;;
        esac
        ;;
    *)
        echo "stub: unknown command $1" >&2
        exit 1
        ;;
esac
